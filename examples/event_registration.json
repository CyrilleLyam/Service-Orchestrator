{
  "code": "event-registration",
  "name": "Conference Registration",
  "description": "Register for the conference and choose sessions. Fees depend on attendee type and workshops.",
  "definition": {
    "dataSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": ["fullName", "email", "attendeeType", "sessions"],
      "properties": {
        "fullName": {"type": "string", "minLength": 1, "maxLength": 200},
        "email": {"type": "string", "format": "email", "maxLength": 254},
        "attendeeType": {"enum": ["student", "professional", "corporate"]},
        "studentId": {"type": "string", "pattern": "^[A-Z0-9-]{4,20}$"},
        "companyName": {"type": "string", "minLength": 1, "maxLength": 200},
        "sessions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["keynote", "workshop-a", "workshop-b"]}
        }
      }
    },
    "rules": [
      {
        "id": "student-id-required",
        "type": "require",
        "when": {"==": [{"var": "attendeeType"}, "student"]},
        "fields": ["studentId"],
        "message": {"en": "Students must provide a student ID."}
      },
      {
        "id": "student-id-only-for-students",
        "type": "visible",
        "when": {"==": [{"var": "attendeeType"}, "student"]},
        "fields": ["studentId"]
      },
      {
        "id": "company-required",
        "type": "require",
        "when": {"==": [{"var": "attendeeType"}, "corporate"]},
        "fields": ["companyName"]
      },
      {
        "id": "company-only-for-corporate",
        "type": "visible",
        "when": {"==": [{"var": "attendeeType"}, "corporate"]},
        "fields": ["companyName"]
      },
      {
        "id": "workshops-same-slot",
        "type": "assert",
        "assert": {
          "!": {
            "and": [
              {"in": ["workshop-a", {"var": "sessions"}]},
              {"in": ["workshop-b", {"var": "sessions"}]}
            ]
          }
        },
        "path": "/sessions",
        "message": {"en": "Workshops A and B run at the same time; choose one."}
      }
    ],
    "fees": [
      {"code": "STUDENT", "label": {"en": "Student pass"}, "amount": 10000, "currency": "KHR", "when": {"==": [{"var": "attendeeType"}, "student"]}},
      {"code": "PROFESSIONAL", "label": {"en": "Professional pass"}, "amount": 40000, "currency": "KHR", "when": {"==": [{"var": "attendeeType"}, "professional"]}},
      {"code": "CORPORATE", "label": {"en": "Corporate pass"}, "amount": 80000, "currency": "KHR", "when": {"==": [{"var": "attendeeType"}, "corporate"]}},
      {"code": "WORKSHOP_A", "label": {"en": "Workshop A"}, "amount": 20000, "currency": "KHR", "when": {"in": ["workshop-a", {"var": "sessions"}]}},
      {"code": "WORKSHOP_B", "label": {"en": "Workshop B"}, "amount": 20000, "currency": "KHR", "when": {"in": ["workshop-b", {"var": "sessions"}]}}
    ],
    "uiSchema": {
      "steps": [
        {"id": "attendee", "title": {"en": "About you"}, "fields": ["fullName", "email", "attendeeType", "studentId", "companyName"]},
        {"id": "sessions", "title": {"en": "Sessions"}, "fields": ["sessions"]}
      ],
      "fields": {"attendeeType": {"widget": "radio"}, "sessions": {"widget": "checkbox-group"}}
    }
  }
}
